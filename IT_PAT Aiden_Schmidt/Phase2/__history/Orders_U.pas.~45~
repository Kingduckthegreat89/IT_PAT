unit Orders_U;

interface

uses
  Windows, Messages, SysUtils, Variants, Classes, Graphics, Controls, Forms,
  Dialogs, StdCtrls, ComCtrls, Spin, ADODB, DB, conData, StrUtils;

type
  TfrmOrders = class(TForm)
    btnChangeOrder: TButton;
    btnCheckStock: TButton;
    btnEdit: TButton;
    btnItemAdd: TButton;
    btnListItems: TButton;
    btnRemove: TButton;
    cmbItems: TComboBox;
    cmbStock: TComboBox;
    lblDoesNothingButShowSomething: TLabel;
    lblLbl: TLabel;
    lblOrder: TLabel;
    redDisplay: TRichEdit;
    spnAmount: TSpinEdit;
    btnDone: TButton;
    procedure lblOrderClick(Sender: TObject);
    procedure btnListItemsClick(Sender: TObject);
    procedure btnCheckStockClick(Sender: TObject);
    procedure FormCreate(Sender: TObject);
    procedure btnEditClick(Sender: TObject);
    procedure btnItemAddClick(Sender: TObject);
    procedure FormCloseQuery(Sender: TObject; var CanClose: Boolean);
    procedure btnChangeOrderClick(Sender: TObject);
    procedure btnRemoveClick(Sender: TObject);
    procedure btnDoneClick(Sender: TObject);
  private
    { Private declarations }
    procedure OrderFormat;
  public
    { Public declarations }

  end;

var
  frmOrders: TfrmOrders;
  arrPromoCodes : array [1..12] of string = ('kingduck','geesebad','duck','haaskop','microwave','waar','trees','papyrus','birdstrike','cats','whoami','gentoobtw');
  rTotal :real;
  bHasDiscount :boolean;

implementation

uses
  Main_U, usrStart_U, Settings_U;

{$R *.dfm}

procedure TfrmOrders.btnChangeOrderClick(Sender: TObject);
var
  sRandomCode, sActualCode: string;
  i: integer;
  bFound: boolean;
  rNewTotal: real;
begin
  Randomize;
  sRandomCode := arrPromoCodes[Random(12) + 1];   // 1..12, stays in bounds

  with conData.dbmDatadb do
  begin
    tblOrdersdb.Open;
    tblOrdersdb.First;
    OrderFormat;

    if tblOrdersdb.IsEmpty then
    begin
      ShowMessage('There are no orders to edit.');
      Exit;
    end;

    redDisplay.Lines.Add(IntToStr(tblOrdersdb['OrderID']) + #9 +
      tblOrdersdb['clientName'] + tblOrdersdb['clientSurname'] + #9 +
      tblOrdersdb['Item'] + #9 +
      FloatToStrF(tblOrdersdb['Total'], ffCurrency, 8, 2));

    MessageDlg('Currently the only thing you can edit is whether or not ' +
      'you have a secret code. This button is therefore purely used to ' +
      'retry secret codes. Kinda disappointing, I know. Hey, at least you ' +
      'now know that one of the secret codes is ' + sRandomCode,
      mtInformation, mbOKCancel, 0);

    sActualCode := InputBox('Code box',
      'Please enter the second attempt at the correct code', '');

    // Check the code against the array (case-insensitive)
    bFound := False;
    for i := 1 to 12 do
      if SameText(sActualCode, arrPromoCodes[i]) then
      begin
        bFound := True;
        Break;
      end;

    if bFound then
    begin
      ShowMessage('You got it right!');

      rNewTotal := tblOrdersdb['Total'];
      if rNewTotal > 0 then
      begin
        rNewTotal := rNewTotal * 100 / 115;   // remove the 15% amount

        // Save the change to the table
        tblOrdersdb.Edit;
        tblOrdersdb['Total'] := rNewTotal;
        tblOrdersdb.Post;
      end;
    end
    else
      ShowMessage('Wrong code');
  end;
end;

procedure TfrmOrders.btnCheckStockClick(Sender: TObject);
var
  sItem :string;
begin
  // Guard against nothing being selected before reading the item text
  if cmbStock.ItemIndex = -1 then
  begin
    MessageDlg('Please select a value before checking stock!', mtError, mbOKCancel, 0);
    Exit;
  end;

  sItem := cmbStock.Items[cmbStock.ItemIndex];

  with conData.dbmDatadb do
  begin
    tblItemsdb.First;
    while NOT tblItemsdb.Eof do
    begin
      if tblItemsdb['Item'] = sItem then
      begin
        showmessage(sItem + ':' + inttostr(tblItemsdb['Stock']) + ' left');
        break;
      end
      else
        tblItemsdb.Next;
    end;
  end;
end;

procedure TfrmOrders.btnDoneClick(Sender: TObject);
var
  iQuit :integer;
begin
  iQuit := MessageDlg('Thanks for ordering!(if you did not order, thanks anyway)', mtInformation, mbOKCancel, 0);
  if iQuit = mrOK then
    Application.Terminate;
end;

procedure TfrmOrders.btnEditClick(Sender: TObject);
begin
  btnChangeOrder.Visible := true;
end;

procedure TfrmOrders.btnItemAddClick(Sender: TObject);
var
  sItem, sItemType, sClientName, sClientSurname, sBank, sCode :string;
  iPrice, iNumberofItems, i :integer;
begin
  // Guard against nothing being selected before reading the item text
  if cmbItems.ItemIndex = -1 then
  begin
    MessageDlg('Please select an item first!', mtError, mbOKCancel, 0);
    Exit;
  end;

  sItem := cmbItems.Items[cmbItems.ItemIndex];
  bHasDiscount := false;
  rTotal := 0;   // reset per order, so totals don't carry over between orders

  //Check if the item exists in the database
  with conData.dbmDatadb do
  begin
    tblItemsdb.First;

    while not tblItemsdb.Eof do
    begin
      if sItem = tblItemsdb['Item'] then
      begin
        iPrice := tblItemsdb['Price'];
        sItemType := tblItemsdb['itemType'];
        iNumberofItems := spnAmount.Value;

        sClientName := inputbox('Your Name', 'Please enter your first name', '');
        sClientSurname := inputbox('Your surname', 'Please enter your surname', '');
        sbank := InputBox('Bank', 'Please enter which bank you use(type "no" if you prefer not answering)', '');

        // Validate the entered fields before touching stock or the database
        if (sClientName = '') OR (sClientSurname = '') OR (sItem = '') OR (sItemType = '') then
        begin
          MessageDlg('Correct data has not been entered in either 1 or more fields, please ensure you have filled out ALL the fields that you were asked to fill'
            , mtError, mbOKCancel, 0);
          break;
        end;

        rTotal := rTotal + iPrice;
        sCode := InputBox('Code', 'Get [[SUPER LOW DISCOUNT]] by entering a [[MEGA SECRET CODE]] for a chance at [[15% OFF!!]]', '');
        for i := Low(arrPromoCodes) to High(arrPromoCodes) do
        begin
          if SameText(sCode, arrPromoCodes[i]) then
            bHasDiscount := true;
        end;

        //Database logic
        if tblItemsdb['Stock'] = 0 then
        begin
          Showmessage('We have ran out of stock for this item. Sorry for the inconvenience! We (Unfortuantly wont since the creator is greedy) will notify you once we have stock again');
          break;
        end
        else if iNumberofItems > tblItemsdb['Stock'] then
        begin
          Showmessage('There is not enough stock left for that quantity. Please choose a smaller amount.');
          break;
        end
        else
        begin
          tblItemsdb.Edit;
          tblItemsdb['Stock'] := tblItemsdb['Stock'] - iNumberofItems;
          tblItemsdb.Post;
        end;

        if sBank = '' then
          sBank := 'Not shared';

        tblOrdersdb.Open;
        tblOrdersdb.Append;
        tblOrdersdb['clientName'] := sClientName;
        tblOrdersdb['clientSurname'] := sClientSurname;
        tblOrdersdb['Bank'] := sBank;
        tblOrdersdb['Item'] := sItem;
        tblOrdersdb['ItemType'] := sItemType;
        tblOrdersdb['discountOption'] := bHasDiscount;
        tblOrdersdb['discountValue'] := 15;

        if bHasDiscount then
          rTotal := rTotal * 0.85;   // take 15% off

        tblOrdersdb['Total'] := rTotal;
        //break the loop if finished
        tblOrdersdb.Post;
        break;
      end
      else
        tblItemsdb.Next;
    end;
  end;
end;

procedure TfrmOrders.btnListItemsClick(Sender: TObject);
begin
  redDisplay.Lines.Clear;
  redDisplay.Lines.Add('Item Name:' + #9 + '| Price:');
  cmbStock.Items.Clear;
  cmbItems.Items.Clear;

  with conData.dbmDatadb do
  begin
    tblItemsdb.First;

    while NOT tblItemsdb.Eof do
    begin
      if tblItemsdb['Secret Item'] = false then
      begin
        redDisplay.Lines.Add(tblItemsdb['Item'] + #9 + floattostrf(tblItemsdb['Price'], ffCurrency, 8, 2)
          + #10 + '----------------------------------------------------------------------------------------');
        cmbStock.Items.Add(tblItemsdb['Item']);
        cmbItems.Items.Add(tblItemsdb['Item']);
      end;
      tblItemsdb.Next;
    end;
  end;
end;

procedure TfrmOrders.btnRemoveClick(Sender: TObject);
var
  sUsrName, sFullName :string;
  bUsrFound, bFoundRecord :boolean;
begin
  bUsrFound := False;
  bFoundRecord := false;
  with conData.dbmDatadb do
  begin
    {How to remove orders
       1. Display order list based on the user's name
       2. Allow them to select the order number and loop to it
       3. Delete the order on the selected number
    }
    tblOrdersdb.Open;
    tblOrdersdb.First;
    sUsrName := InputBox('Name', 'Enter your name/the name you entered on your past orders', '');

    while not tblOrdersdb.Eof do
    begin
      if uppercase(sUsrName) = uppercase(tblOrdersdb['clientName']) then
      begin
        bUsrFound := true;
        sFullName := sUsrName + ' ' + tblOrdersdb['clientSurname'];
        OrderFormat;
        redDisplay.Lines.Add(inttostr(tblOrdersdb['OrderID']) + #9 + sFullName + #9 +tblOrdersdb['Item'] + #9 + floattostrf(tblOrdersdb['Total'], ffCurrency, 8, 2));
        break;
      end
      else
        tblOrdersdb.Next;
    end;

    if not bUsrFound then
    begin
      showmessage('Your name was not found, either you made a mistake in spelling or you have not made an order');
      Exit;
    end;

    repeat
      case MessageDlg('Is this the correct order ID?', mtConfirmation, mbYesNoCancel, 0) of
        mrCancel:
          begin
            ShowMessage('Record deletion canceled');
            Exit;
          end;
        mrYes:
          begin
            ShowMessage('Deleting order');
            tblOrdersdb.Delete;
            Showmessage('Order Deleted');
            bFoundRecord := true;
            Showmessage('Please give me a good rating, I haven' + #39 +'t  been fed in days. That salesman promised me food if I made enough Kromer for him. Promised me that I could be a BIGSHOT. I hope he was teling the truth.');
          end;
        mrNo:
          begin
            // Move to the next order belonging to the same client, if any
            tblOrdersdb.Next;
            while (not tblOrdersdb.Eof) and (uppercase(sUsrName) <> uppercase(tblOrdersdb['clientName'])) do
              tblOrdersdb.Next;

            if tblOrdersdb.Eof then
            begin
              ShowMessage('No more orders found for that name.');
              Exit;
            end;

            sFullName := sUsrName + ' ' + tblOrdersdb['clientSurname'];
            OrderFormat;
            redDisplay.Lines.Add(inttostr(tblOrdersdb['OrderID']) + #9 + sFullName + #9 +tblOrdersdb['Item'] + #9 + floattostrf(tblOrdersdb['Total'], ffCurrency, 8, 2));
          end;
      end;
    until bFoundRecord;
  end;
end;

procedure TfrmOrders.FormCloseQuery(Sender: TObject; var CanClose: Boolean);
var
  iQuit :integer;
begin
  iQuit := MessageDlg('Are you sure you want to quit?', mtConfirmation, mbYesNo, 0);
  if iQuit = mrYes then
    Application.Terminate
  else
    CanClose := false;
end;

procedure TfrmOrders.FormCreate(Sender: TObject);
begin
  redDisplay.Paragraph.TabCount := 3;
  redDisplay.Paragraph.Tab[1] := 100;
  redDisplay.Paragraph.Tab[2] := 200;
  redDisplay.Paragraph.Tab[3] := 300;
end;

procedure TfrmOrders.lblOrderClick(Sender: TObject);
begin
  showmessage('Chaos');
end;

procedure TfrmOrders.OrderFormat;
begin
  redDisplay.Lines.Clear;
  redDisplay.Lines.Add('Order ID:' + #9 + '|' + 'Full Name:' + #9 + '|' + 'Item:' + #9 + '|' + 'Total:' + #9);
end;

end.
