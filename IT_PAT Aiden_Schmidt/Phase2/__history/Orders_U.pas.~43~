function TfrmOrders.HasDiscount(): Boolean;
var
 bHasCode :boolean;
begin
  with conData.dbmDatadb do
  begin
    while not tblOrdersdb.Eof do
    begin
      bHasCode := tblOrdersdb['discountOption'];

      if bHasCode = true then
      begin
        Result := true;
        break;
      end
      else
      begin
        Result := false;
        tblOrdersdb.Next;
      end;
    end;
  end;
end;

