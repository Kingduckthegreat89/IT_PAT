unit admStart_U;

interface

uses
  Windows, Messages, SysUtils, Variants, Classes, Graphics, Controls, Forms,
  Dialogs, StdCtrls, DB, ADODB, Grids, DBGrids;

type
  TfrmAdmMenu = class(TForm)
    btnDatabaseForm: TButton;
    btnReviewFeedBack: TButton;
    btnOrders: TButton;
    btnCodes: TButton;
    btnNukeApp: TButton;
    Label1: TLabel;
    dbgTables: TDBGrid;
    btnSave: TButton;
    procedure FormClose(Sender: TObject; var Action: TCloseAction);
    procedure btnNukeAppClick(Sender: TObject);
    procedure Label1Click(Sender: TObject);
    procedure btnDatabaseFormClick(Sender: TObject);
    procedure btnOrdersClick(Sender: TObject);
    procedure btnSaveClick(Sender: TObject);
  private
    { Private declarations }
    function WhichTable (const sPrompt :string): integer;
  public
    { Public declarations }
  end;

var
  frmAdmMenu: TfrmAdmMenu;

implementation
uses
Main_U, conData;

{$R *.dfm}

procedure TfrmAdmMenu.btnDatabaseFormClick(Sender: TObject);
begin
  dbgTables.Visible := true;
  btnSave.Visible := True;
  dbgTables.DataSource := conData.dbmDatadb.dscDatadb;
  conData.dbmDatadb.tblItemsdb.Open;
  conData.dbmDatadb.tblItemsdb.Edit;
end;

procedure TfrmAdmMenu.btnNukeAppClick(Sender: TObject);
begin
  frmMain.CloseApp;
end;

procedure TfrmAdmMenu.btnOrdersClick(Sender: TObject);
begin
  dbgTables.DataSource := conData.dbmDatadb.dscData2db;
  dbgTables.Visible := True;
  conData.dbmDatadb.tblOrdersdb.Open;
  conData.dbmDatadb.tblOrdersdb.Edit;
  btnSave.Visible := True;
end;

procedure TfrmAdmMenu.btnSaveClick(Sender: TObject);
var
  iMsgResult :integer;
begin
  iMsgResult := WhichTable('Which table do you want to save?');

  case iMsgResult of
    6:
    begin
      with conData.dbmDatadb do
      begin
        tblOrdersdb.Post;
        dbgTables.Visible := false;
        btnSave.Visible := false;
      end;
    end;
    7:
    begin
      with conData.dbmDatadb do
      begin
        tblItemsdb.Post;
        dbgTables.Visible := false;
        btnSave.Visible := false;
      end;
    end;
  end;
end;

procedure TfrmAdmMenu.FormClose(Sender: TObject; var Action: TCloseAction);
begin
 Action := caHide;
 frmMain.Show;
end;

procedure TfrmAdmMenu.Label1Click(Sender: TObject);
begin
Showmessage('Hello person who clicked a label and not a button');
end;

function TfrmAdmMenu.WhichTable(const sPrompt: string): integer;
var
 frmPrompt :Tform;
 i :integer;
begin
  frmPrompt := CreateMessageDialog(sPrompt, mtConfirmation, [mbYes, mbNo]);

  try
    for i := 0 to frmPrompt.ComponentCount - 1 do
      if frmPrompt.Components[i] is TButton then
        with TButton(frmPrompt.Components[i]) do
          begin
          if ModalResult = mrYes then Caption := 'Save Orders?';
          if ModalResult = mrNo then Caption := 'Save Items?';
          end;
    Result := frmPrompt.ShowModal;
  finally
    frmPrompt.Free;
  end;

end;


end.
