procedure TfrmAdmMenu.btnSaveClick(Sender: TObject);
var
  iMsgResult :integer;
begin
  iMsgResult := WhichTable('Which table do you want to save?');

  case iMsgResult of
    6:
    begin
      with conData.dbmDatadb do
      begin
        tblOrdersdb.Post;
        dbgTables.Visible := false;
        btnSave.Visible := false;
      end;
    end;
    7:
    begin
      with conData.dbmDatadb do
      begin
        tblItemsdb.Post;
        dbgTables.Visible := false;
        btnSave.Visible := false;
      end;
    end;
  end;
end;

procedure TfrmAdmMenu.FormClose(Sender: TObject; var Action: TCloseAction);
begin
 Action := caHide;
 frmMain.Show;
end;

procedure TfrmAdmMenu.Label1Click(Sender: TObject);
begin
Showmessage('Hello person who clicked a label and not a button');
end;

function TfrmAdmMenu.SelectFeedBackType(const sType: string): integer;
var
 frmAsk :Tform;
 i :integer;
begin
  frmAsk := CreateMessageDialog(sType, mtConfirmation, [mbYes, mbNo]);

  try
    for i := 0 to frmAsk.ComponentCount - 1 do
      if frmAsk.Components[i] is TButton then
        with TButton(frmAsk.Components[i]) do
          begin
          if ModalResult = mrYes then Caption := 'Positive';
          if ModalResult = mrNo then Caption := 'Negative';
          end;
    Result := frmAsk.ShowModal;
  finally
    frmAsk.Free;
  end;

end;

function TfrmAdmMenu.WhichTable(const sPrompt: string): integer;
var
 frmPrompt :Tform;
 i :integer;
begin
  frmPrompt := CreateMessageDialog(sPrompt, mtConfirmation, [mbYes, mbNo]);

  try
    for i := 0 to frmPrompt.ComponentCount - 1 do
      if frmPrompt.Components[i] is TButton then
        with TButton(frmPrompt.Components[i]) do
          begin
          if ModalResult = mrYes then Caption := 'Save Orders?';
          if ModalResult = mrNo then Caption := 'Save Items?';
          end;
    Result := frmPrompt.ShowModal;
  finally
    frmPrompt.Free;
  end;

end;


end.
