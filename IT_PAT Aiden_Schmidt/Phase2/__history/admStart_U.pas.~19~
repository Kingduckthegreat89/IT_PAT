unit admStart_U;

interface

uses
  Windows, Messages, SysUtils, Variants, Classes, Graphics, Controls, Forms,
  Dialogs, StdCtrls, DB, ADODB, Grids, DBGrids, ComCtrls, jpeg, ExtCtrls;

type
  TfrmAdmMenu = class(TForm)
    btnDatabaseForm: TButton;
    btnReviewFeedBack: TButton;
    btnOrders: TButton;
    btnCodes: TButton;
    btnNukeApp: TButton;
    lblTitle: TLabel;
    dbgTables: TDBGrid;
    btnSave: TButton;
    imgBG: TImage;
    procedure FormClose(Sender: TObject; var Action: TCloseAction);
    procedure btnNukeAppClick(Sender: TObject);
    procedure lblTitleClick(Sender: TObject);
    procedure btnDatabaseFormClick(Sender: TObject);
    procedure btnOrdersClick(Sender: TObject);
    procedure btnSaveClick(Sender: TObject);
    procedure btnReviewFeedBackClick(Sender: TObject);
    procedure FormCreate(Sender: TObject);
  private
    { Private declarations }
    redFeedback :TRichEdit;
    function WhichTable (const sPrompt :string): integer;
    function SelectFeedBackType (const sType :string): integer;

  public
    { Public declarations }
  end;

var
  frmAdmMenu: TfrmAdmMenu;

implementation
uses
Main_U, conData;

{$R *.dfm}

procedure TfrmAdmMenu.btnDatabaseFormClick(Sender: TObject);
begin
  try
    redFeedback.Free;
  finally
    dbgTables.Visible := true;
    btnSave.Visible := True;
    dbgTables.DataSource := conData.dbmDatadb.dscDatadb;
    conData.dbmDatadb.tblItemsdb.Open;
    conData.dbmDatadb.tblItemsdb.Edit;
  end;
end;

procedure TfrmAdmMenu.btnNukeAppClick(Sender: TObject);
begin
  frmMain.CloseApp;
end;

procedure TfrmAdmMenu.btnOrdersClick(Sender: TObject);
begin
  try
    redFeedback.Free;
  finally
    dbgTables.DataSource := conData.dbmDatadb.dscData2db;
    dbgTables.Visible := True;
    conData.dbmDatadb.tblOrdersdb.Open;
    conData.dbmDatadb.tblOrdersdb.Edit;
    btnSave.Visible := True;
  end;
end;

procedure TfrmAdmMenu.btnReviewFeedBackClick(Sender: TObject);
var
  tfFeedback :TextFile;
  iResult, iSlashPos, iPipePos :integer;
  sLine, sName, sFeedbackType, sFeedback :string;
begin
  redFeedback := TRichEdit.Create(self);
  with redFeedBack do
  begin
    Parent := self;
    left := dbgTables.Left;
    top := dbgTables.Top;
    Height := dbgTables.Height;
    Width := dbgTables.Width;
    Paragraph.TabCount := 3;
    Paragraph.Tab[1] := 100;
    Paragraph.Tab[2] := 200;
    Paragraph.Tab[3] := 300;
  end;
  iResult := SelectFeedBackType('Do you want to view positive or negative feedback?');

  case iResult of
    6:
      begin
        AssignFile(tfFeedBack, './DATA/Feedback/Positive_feedback.txt');

        if FileExists('./DATA/Feedback/Positive_feedback.txt') then
        Reset(tfFeedback)
        else
        begin
          MessageDlg('File not found/no feedback of this type', mtError, mbOKCancel, 0);
          exit;
        end;

        while not Eof(tfFeedback) do
        begin
          Readln(tfFeedback, sLine);
          sName := '';
          sFeedbackType := '';
          sFeedback := '';
          ///  1: read sLine
          ///  2: get the element before the slash(pos)
          ///  3: delete the part of the sLine that was store in another variable
          ///  4: if the string is empty then move to the next line and repeat until EOF

          repeat
            if sName = '' then
              begin
                iSlashPos := Pos('/', sLine);
                sName := Copy(sLine, 1, iSlashPos -1);
                Delete(sLine, 1, iSlashPos);
              end
            else if sFeedbackType = '' then
              begin
                iSlashPos := Pos('/', sLine);
                sFeedbackType := Copy(sLine, 1, iSlashPos -1);
                Delete(sLine, 1, iSlashPos);
              end
            else if sFeedback = '' then
              begin
                iPipePos := Pos('|', sLine);
                sFeedback := Copy(sLine, 1, iPipePos -1);
                Delete(sLine, 1, iSlashPos)
              end
            else if sLine <> '' then
            begin
              Delete(sLine, 1, 1000);
            end;


          until (sline = '') or (iSlashPos = 0) ;
          redFeedback.Lines.Add(sName + #9 + '|' + sFeedbackType + #9 + '|'  + sFeedback)
        end;


      end;
    7:
      begin
        AssignFile(tfFeedBack, './DATA/Feedback/Negative_feedback.txt');

        if FileExists('./DATA/Feedback/Negative_feedback.txt') then
        Reset(tfFeedback)
        else
        begin
          MessageDlg('File not found/no feedback of this type', mtError, mbOKCancel, 0);
          exit;
        end;

        while not Eof(tfFeedback) do
        begin
          Readln(tfFeedback, sLine);
          sName := '';
          sFeedbackType := '';
          sFeedback := '';

          repeat
            if sName = '' then
              begin
                iSlashPos := Pos('/', sLine);
                sName := Copy(sLine, 1, iSlashPos -1);
                Delete(sLine, 1, iSlashPos);
              end
            else if sFeedbackType = '' then
              begin
                iSlashPos := Pos('/', sLine);
                sFeedbackType := Copy(sLine, 1, iSlashPos -1);
                Delete(sLine, 1, iSlashPos);
              end
            else if sFeedback = '' then
              begin
                iPipePos := Pos('|', sLine);
                sFeedback := Copy(sLine, 1, iPipePos -1);
                Delete(sLine, 1, iSlashPos)
              end
            else if sLine <> '' then
            begin
              Delete(sLine, 1, 1000);
            end;


          until (sline = '') or (iSlashPos = 0) ;
          redFeedback.Lines.Add(sName + #9 + '|' + sFeedbackType + #9 + '|'  + sFeedback)
        end;


      end;
      end;
  end;

procedure TfrmAdmMenu.btnSaveClick(Sender: TObject);
var
  iMsgResult :integer;
begin
  iMsgResult := WhichTable('Which table do you want to save?');

  case iMsgResult of
    6:
    begin
      with conData.dbmDatadb do
      begin
        tblOrdersdb.Post;
        dbgTables.Visible := false;
        btnSave.Visible := false;
      end;
    end;
    7:
    begin
      with conData.dbmDatadb do
      begin
        tblItemsdb.Post;
        dbgTables.Visible := false;
        btnSave.Visible := false;
      end;
    end;
  end;
end;

procedure TfrmAdmMenu.FormClose(Sender: TObject; var Action: TCloseAction);
begin
 Action := caHide;
 frmMain.Show;
end;

procedure TfrmAdmMenu.FormCreate(Sender: TObject);
var
  tfConfig :TextFile;
  sConfig :string;
begin
  AssignFile(tfConfig, './DATA/config/config.txt');

  Reset(tfConfig);

  while not EOF(tfConfig) do
    begin
      ReadLn(tfConfig, sConfig);

      if pos('Backgrounds|Disabled', sConfig) > 0 then
          imgBG.Visible := false;

    end;
    CloseFile(tfConfig);
end;

procedure TfrmAdmMenu.lblTitleClick(Sender: TObject);
begin
Showmessage('How cruel, have you no [[heartshapedobject]]?');
end;

function TfrmAdmMenu.SelectFeedBackType(const sType: string): integer;
var
 frmAsk :Tform;
 i :integer;
begin
  frmAsk := CreateMessageDialog(sType, mtConfirmation, [mbYes, mbNo]);

  try
    for i := 0 to frmAsk.ComponentCount - 1 do
      if frmAsk.Components[i] is TButton then
        with TButton(frmAsk.Components[i]) do
          begin
          if ModalResult = mrYes then Caption := 'Positive';
          if ModalResult = mrNo then Caption := 'Negative';
          end;
    Result := frmAsk.ShowModal;
  finally
    frmAsk.Free;
  end;

end;



function TfrmAdmMenu.WhichTable(const sPrompt: string): integer;
var
 frmPrompt :Tform;
 i :integer;
begin
  frmPrompt := CreateMessageDialog(sPrompt, mtConfirmation, [mbYes, mbNo]);

  try
    for i := 0 to frmPrompt.ComponentCount - 1 do
      if frmPrompt.Components[i] is TButton then
        with TButton(frmPrompt.Components[i]) do
          begin
          if ModalResult = mrYes then Caption := 'Save Orders?';
          if ModalResult = mrNo then Caption := 'Save Items?';
          end;
    Result := frmPrompt.ShowModal;
  finally
    frmPrompt.Free;
  end;

end;


end.
